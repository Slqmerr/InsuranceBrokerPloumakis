# Form backend (app/api/quote/route.ts) — email delivery via https://resend.com
# Copy to .env.local for local development; set the same vars on Vercel for production.
# Without these, dev logs submissions to the console; production returns an error.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives all form submissions (Dimitrios' email)
QUOTE_TO_EMAIL=

# Verified sender address (optional — defaults to onboarding@resend.dev,
# which works without domain verification but only for testing)
QUOTE_FROM_EMAIL=

# Keystatic CMS (GitHub mode) — editor auth for the /keystatic admin panel.
# Created by a GitHub App on the Slqmerr/InsuranceBrokerPloumakis repo;
# Keystatic's first-run wizard at /keystatic can create the app and fill
# these in. Set the same vars on Vercel, then redeploy.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
# Random secret for signing Keystatic auth cookies (e.g. `openssl rand -hex 40`)
KEYSTATIC_SECRET=
# The GitHub App's slug (from https://github.com/apps/<slug>) — exposed to the
# browser so the admin UI can link to the app's install/authorize pages
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
